{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SAP Portfolio Config Schema",
  "type": "object",
  "properties": {
    "project_name": { "type": "string" },
    "version": { "type": "string" },
    "description": { "type": "string" },
    "configuration": {
      "type": "object",
      "properties": {
        "sap_sync": {
          "type": "object",
          "properties": {
            "auto_detect": { "type": "boolean" },
            "sap_host_env_var": { "type": "string" },
            "status": { "type": "string" }
          },
          "required": ["auto_detect", "sap_host_env_var"]
        },
        "portfolio_data_sources": { "type": "object" }
      },
      "required": ["sap_sync", "portfolio_data_sources"]
    },
    "git_user": { "type": "string" },
    "contact_email": { "type": "string" }
  },
  "required": ["project_name", "version", "configuration", "git_user", "contact_email"]
}
